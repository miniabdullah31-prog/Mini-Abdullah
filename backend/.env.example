# Backend environment template — copy values into backend/.env
PORT=5000
MONGO_URI=
JWT_SECRET=
# Optional: comma-separated origins. Leave empty to allow all (mobile / FYP default).
CORS_ORIGIN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Email (SMTP) — ONE app sender account (not each user's email).
# User emails already save automatically in MongoDB on signup.
# Leave SMTP empty for local/FYP testing — OTP will show in app + backend console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mini Abdullah <noreply@miniabdullah.app>"
DEV_OTP_MODE=true

# Where Contact Support / Feedback emails are delivered
SUPPORT_TO_EMAIL=

# Firebase Cloud Messaging + Google Sign-In token verification (server-side only)
# Download service account JSON from Firebase Console → Project Settings → Service accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or paste minified JSON on one line (alternative to file):
# FIREBASE_SERVICE_ACCOUNT_JSON=
ENABLE_FCM_SCHEDULER=true
# One-shot FCM test ~5 minutes after backend start (plays sound on phone).
# After you verify push works, set this to false and restart the server.
ENABLE_FCM_TEST_PUSH=true

# Optional Zoom meeting URLs copied onto new tutor appointments (leave empty for FYP until real links exist)
TUTOR_QURAN_ZOOM_LINK=
TUTOR_ISLAMIC_ZOOM_LINK=

# Optional CDN/public origin for /media files. Leave empty in FYP — the app prefixes API_BASE_URL.
MEDIA_PUBLIC_BASE_URL=
